# 실제 값은 여기 채우지 말고 .env(로컬) 또는 Vercel 프로젝트 환경변수(배포)에 등록한다.
# 이 파일 자체는 예시일 뿐이며 git에 커밋해도 안전하다(비밀값 없음).

# --- AI 업무 추출 ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# --- 닉네임 로그인 + 사용자별 서버 저장 ---
# Postgres 접속 문자열. 아래 둘 중 아무 이름이나 쓰면 된다(둘 다 있으면 DATABASE_URL 우선).
#   예) postgres://user:password@host:5432/dbname?sslmode=require
# 값을 비워두면(로컬에서) 자동으로 .data/app.sqlite(로컬 전용 SQLite)로 대체되고,
# Vercel 배포본에서는 비워두면 로그인·저장 API가 모두 503을 반환한다(가짜 저장 성공을 만들지 않음).
DATABASE_URL=
# POSTGRES_URL=

# --- 관리자 가입(최초 1회) ---
# 관리자 회원가입 화면에서 입력해야 하는 비공개 초대 코드. 서버에서만 읽고 응답·로그에 남기지 않는다.
# 최초 관리자 1명이 만들어지면 가입 경로 자체가 닫히므로, 그 뒤에는 이 값이 있어도 가입되지 않는다.
# 충분히 긴 무작위 문자열을 직접 정해서 넣는다(예: openssl rand -hex 24 결과).
ADMIN_INVITE_CODE=

# --- 테스트 전용(선택) ---
# 로컬에서 격리된 SQLite 파일로 띄우고 싶을 때만 사용한다. 비워두면 .data/app.sqlite를 쓴다.
# SQLITE_PATH=
